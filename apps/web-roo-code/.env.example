# Database
DATABASE_URL="postgresql://user:password@localhost:5432/roo_code"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# GitHub OAuth (optional)
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"

# Application
NODE_ENV="development"
PORT=3000

# Redis (optional, for caching and vector memory)
REDIS_URL="redis://localhost:6379"

# Qdrant (optional, for vector memory)
QDRANT_URL="http://localhost:6333"
QDRANT_COLLECTION_NAME="roo_code_memory"

# File Storage
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# ============================================
# AI Provider API Keys
# 完全兼容 VSCode 版本的所有配置
# ============================================

# Anthropic (Claude)
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_BASE_URL="https://api.anthropic.com"  # 可选，自定义端点

# OpenAI
OPENAI_API_KEY="your-openai-api-key"
OPENAI_NATIVE_API_KEY="your-openai-native-api-key"  # 原生OpenAI API

# OpenRouter
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_IMAGE_API_KEY="your-openrouter-image-api-key"  # 图片生成

# AWS Bedrock
AWS_ACCESS_KEY="your-aws-access-key"
AWS_SECRET_KEY="your-aws-secret-key"
AWS_SESSION_TOKEN="your-aws-session-token"  # 可选
AWS_API_KEY="your-aws-api-key"

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"

# Ollama (本地模型)
OLLAMA_API_KEY="your-ollama-api-key"  # 通常不需要

# Mistral AI
MISTRAL_API_KEY="your-mistral-api-key"

# DeepSeek
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Moonshot (Kimi)
MOONSHOT_API_KEY="your-moonshot-api-key"

# Doubao (ByteDance)
DOUBAO_API_KEY="your-doubao-api-key"

# Cerebras
CEREBRAS_API_KEY="your-cerebras-api-key"

# xAI (Grok)
XAI_API_KEY="your-xai-api-key"

# Groq
GROQ_API_KEY="your-groq-api-key"

# Glama
GLAMA_API_KEY="your-glama-api-key"

# HuggingFace
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# SambaNova
SAMBANOVA_API_KEY="your-sambanova-api-key"

# Fireworks AI
FIREWORKS_API_KEY="your-fireworks-api-key"

# DeepInfra
DEEPINFRA_API_KEY="your-deepinfra-api-key"

# LiteLLM
LITELLM_API_KEY="your-litellm-api-key"

# Featherless
FEATHERLESS_API_KEY="your-featherless-api-key"

# IO Intelligence
IO_INTELLIGENCE_API_KEY="your-io-intelligence-api-key"

# Vercel AI Gateway
VERCEL_AI_GATEWAY_API_KEY="your-vercel-ai-gateway-api-key"

# Unbound
UNBOUND_API_KEY="your-unbound-api-key"

# Requesty
REQUESTY_API_KEY="your-requesty-api-key"

# Chutes
CHUTES_API_KEY="your-chutes-api-key"

# ZAI
ZAI_API_KEY="your-zai-api-key"

# ============================================
# Codebase Index API Keys (代码索引)
# ============================================
CODEBASE_INDEX_OPENAI_KEY="your-openai-key-for-indexing"
CODEBASE_INDEX_OPENAI_COMPATIBLE_API_KEY="your-openai-compatible-key"
CODEBASE_INDEX_GEMINI_API_KEY="your-gemini-key-for-indexing"
CODEBASE_INDEX_MISTRAL_API_KEY="your-mistral-key-for-indexing"
CODEBASE_INDEX_VERCEL_AI_GATEWAY_API_KEY="your-vercel-ai-gateway-key"
CODEBASE_INDEX_QDRANT_API_KEY="your-qdrant-api-key"