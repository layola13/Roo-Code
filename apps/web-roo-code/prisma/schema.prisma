// Prisma Schema for Roo Code Web

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  githubId  String?  @unique
  tasks     Task[]
  settings  Settings?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            String   @id @default(cuid())
  taskId        String   @unique
  instanceId    String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Json
  configuration Json
  status        String
  checkpoints   Checkpoint[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Settings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  version   Int      @default(1)
  timestamp BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Checkpoint {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  data     Json
  timestamp BigInt
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([timestamp])
}