# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:20-alpine AS deps

# 设置工作目录
WORKDIR /app

# 安装 pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# 复制 workspace 配置文件
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# 复制所有 package.json 文件（用于依赖解析）
COPY packages/types/package.json ./packages/types/
COPY backend-server/package.json ./backend-server/

# 安装所有依赖
RUN pnpm install --frozen-lockfile --filter @roo-code/backend-server... --prod

# ============================================
# Stage 2: Builder
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

# 安装 pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# 复制 workspace 配置
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# 复制所有必要的 package.json
COPY packages/types/package.json ./packages/types/
COPY backend-server/package.json ./backend-server/

# 安装所有依赖（包括开发依赖）
RUN pnpm install --frozen-lockfile --filter @roo-code/backend-server...

# 复制源代码
COPY packages/types ./packages/types
COPY backend-server ./backend-server

# 构建 types 包
WORKDIR /app/packages/types
RUN pnpm build

# 构建 backend-server
WORKDIR /app/backend-server
RUN pnpm build

# ============================================
# Stage 3: Runner
# ============================================
FROM node:20-alpine AS runner

# 安装 dumb-init
RUN apk add --no-cache dumb-init

# 创建非 root 用户
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

# 设置环境变量
ENV NODE_ENV=production \
    PORT=3000

# 从 deps 阶段复制 node_modules
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=nodejs:nodejs /app/backend-server/node_modules ./backend-server/node_modules
COPY --from=deps --chown=nodejs:nodejs /app/packages ./packages

# 从 builder 阶段复制构建产物
COPY --from=builder --chown=nodejs:nodejs /app/backend-server/dist ./backend-server/dist
COPY --from=builder --chown=nodejs:nodejs /app/backend-server/package.json ./backend-server/package.json
COPY --from=builder --chown=nodejs:nodejs /app/packages/types/dist ./packages/types/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/types/package.json ./packages/types/package.json

# 切换工作目录
WORKDIR /app/backend-server

# 切换到非 root 用户
USER nodejs

# 暴露端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# 使用 dumb-init 启动应用
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]